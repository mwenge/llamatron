            "type": "code",
            "source": `import IPython
import numpy as np
import wave
import io

def convert_to_wav(pcm_data):
    # Create an in-memory byte stream
    data = [pcm_data[i] for i in range(0,len(pcm_data))]
    scaled = np.int16(data/np.max(np.abs(data)) * 32767) 
    with io.BytesIO() as wav_stream:
        # Create a wave write object
        with wave.open(wav_stream, 'wb') as wav_file:
            # Set parameters: channels, sample width, frame rate, number of frames
            wav_file.setnchannels(1)  # Mono
            wav_file.setsampwidth(2)  # 16-bit
            wav_file.setframerate(10000)  # Sample rate
            wav_file.writeframes(scaled.tobytes())  # Write PCM data
    
        # Get the WAV data from the stream
        wav_data = wav_stream.getvalue()
    return wav_data

sample = convert_to_wav(sound_bytes)
IPython.display.Audio.Samples = [sample]
